<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>com.apple.security.application-groups</key>
    <array>
        <string>$(TALLY_SHARED_APP_GROUP_ID)</string>
    </array>
    <!-- ENC-03/ENC-05 (encryption.md §3.2/§3.4): the app-private group for
         every vault key except `glance`'s, and the App Group group so the
         app can write the one `glance` key the widget must also read.
         "$(AppIdentifierPrefix)" is an Xcode entitlements-file macro (the
         Team ID); it only expands here, never in compiled Swift, which is
         why KeychainVaultKeyStore takes the resolved group strings as
         plain init parameters instead of hard-coding this prefix. -->
    <key>keychain-access-groups</key>
    <array>
        <string>$(AppIdentifierPrefix)$(PRODUCT_BUNDLE_IDENTIFIER)</string>
        <string>$(AppIdentifierPrefix)$(TALLY_SHARED_APP_GROUP_ID)</string>
    </array>
    <!-- UNNotificationScheduler (reminder port adapter): required to
         actually deliver a `.timeSensitive` request so it can break through
         a Focus filter (security.md §3.3 D7 / architecture.md's "Time
         Sensitive interruption level"); without it iOS silently downgrades
         the interruption level. -->
    <key>com.apple.developer.usernotifications.time-sensitive</key>
    <true/>
    <!-- UX-WP-09 / SEC-05: required for ASWebAuthenticationSession's
         .https(host:path:) callback (iOS 17.4+, security.md §3.2 item 4).
         Only the OAuth callback path is claimed, per the security review:
         "Register only this https redirect in every institution key." -->
    <key>com.apple.developer.associated-domains</key>
    <array>
        <string>webcredentials:$(TALLY_ORG_DOMAIN)</string>
    </array>
</dict>
</plist>
