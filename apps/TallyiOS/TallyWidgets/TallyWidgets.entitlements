<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>com.apple.security.application-groups</key>
    <array>
        <string>$(TALLY_SHARED_APP_GROUP_ID)</string>
    </array>
    <!-- ENC-05: only the App Group group — never the app-private group — so
         the widget process can open the `glance` vault key and nothing else
         (encryption.md §3.4: "It can therefore open glance and nothing
         else: a snapshot open returns keyMissing"). -->
    <key>keychain-access-groups</key>
    <array>
        <string>$(AppIdentifierPrefix)$(TALLY_SHARED_APP_GROUP_ID)</string>
    </array>
</dict>
</plist>
