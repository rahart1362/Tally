    "courseDetail.gradeDistribution.sentence" : {
      "comment" : "Course Detail's grade distribution, one sentence. Each placeholder is an already-formatted percentage: 1 the class minimum, 2 the class maximum, 3 the class average, 4 the student's own.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
