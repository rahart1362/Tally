    "onboarding.schoolSearch.addressHelp.body" : {
      "comment" : "Sheet body: help on finding the school's Canvas address. The ** markers are the source's own emphasis; whether Text renders them as Markdown bold here is UNVERIFIED (not changed by this sweep).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your Canvas address is the web address you already use to sign in on a computer — usually something like **canvas.yourschool.edu** or **yourschool.instructure.com**. You can find it in your school's Canvas mobile app under School Search, or by asking your instructor or IT help desk."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tu dirección de Canvas es la dirección web que ya usas para iniciar sesión en una computadora — normalmente algo como **canvas.tuescuela.edu** o **tuescuela.instructure.com**. Puedes encontrarla en la app móvil de Canvas de tu escuela, en Buscar escuela, o preguntando a tu instructor o a soporte técnico."
          }
        }
      }
    },
    "onboarding.schoolSearch.addressHelp.title" : {
      "comment" : "Sheet title: help on finding the school's Canvas address.",
