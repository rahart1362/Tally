          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld due"
          }
        }
      }
    },
    "notification.weekAhead.countWithBusiest" : {
      "comment" : "Week-ahead body. 1: how many items are due in the next 7 days. 2: the weekday with the most, such as 'Thursday'.",
