        }
      }
    },
    "account.signOutAndErase" : {
      "comment" : "Destructive button that signs the student out and erases Tally's local data. Shown on the lock screen (when there is no device passcode) and in Settings.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sign Out & Erase"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Cerrar sesión y borrar"
          }
        }
      }
    },
    "ageAssurance.restricted.body" : {
      "comment" : "The restricted screen's explanation. No button offers a way past it: the screen stays until Apple reports that consent was given (AGE-1 EB-01(e)/EB-02(b)).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A parent or guardian needs to approve this before you can keep using Tally. Your saved data stays on this iPhone in the meantime."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Un padre, madre o tutor debe aprobar esto antes de que puedas seguir usando Tally. Mientras tanto, tus datos guardados permanecen en este iPhone."
          }
        }
      }
    },
    "ageAssurance.restricted.title" : {
      "comment" : "The restricted screen's title, shown instead of the Dashboard while a parent or guardian's consent for a minor is pending or was withdrawn (AGE-1 EB-01(e)/EB-02(b)).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parent or Guardian Permission Needed"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Se necesita el permiso de un padre, madre o tutor"
          }
        }
      }
    },
