          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Cómo encontrar tu dirección de Canvas"
          }
        }
      }
    },
    "onboarding.schoolSearch.adminRequestText" : {
      "comment" : "X-1: share text sent to a school admin, asking them to enable Tally. The first placeholder is the school's name; the second is Tally's admin-setup domain.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Would you consider enabling Tally at %1$@? It's an app that shows students their Canvas courses, grades and due dates. There's no Tally server and no student accounts — Tally signs in directly with your Canvas, the same way a browser does. Setup takes a Canvas admin a few minutes: https://%2$@/admin"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "¿Considerarían habilitar Tally en %1$@? Es una app que muestra a los estudiantes sus cursos, calificaciones y fechas de entrega de Canvas. No hay servidor de Tally ni cuentas de estudiante — Tally inicia sesión directamente con el Canvas de la escuela, igual que un navegador. La configuración le toma a un administrador de Canvas unos minutos: https://%2$@/admin"
          }
        }
      }
    },
