    "subscription.schoolOff.autoEraseNotice" : {
      "comment" : "EB-26. The school-revoked notice's footnote about the automatic expiry. The argument is a composed length such as '30 days' (L10n.Subscription.days), never a raw number.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If your school keeps Tally turned off, your saved data is also erased automatically after %@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Si tu escuela mantiene Tally desactivado, tus datos guardados también se borran automáticamente después de %@."
          }
        }
      }
    },
    "subscription.schoolOff.body" : {
      "comment" : "The school-revoked notice's text.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your school's Canvas no longer lets Tally connect, so Tally can't refresh. Your saved data stays readable. Your subscription is still active: you can cancel it, or ask Apple for a refund."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "El Canvas de tu escuela ya no permite que Tally se conecte, así que Tally no puede actualizar. Tus datos guardados siguen disponibles. Tu suscripción sigue activa: puedes cancelarla o solicitarle un reembolso a Apple."
          }
        }
      }
    },
    "subscription.schoolOff.bodySeat" : {
      "comment" : "M3-B3: the school-revoked notice's text when the account's only entitlement is a school-assigned seat, without the cancel/refund sentence (the school, not the student, holds that purchase).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your school's Canvas no longer lets Tally connect, so Tally can't refresh. Your saved data stays readable."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "El Canvas de tu escuela ya no permite que Tally se conecte, así que Tally no puede actualizar. Tus datos guardados siguen disponibles."
          }
        }
      }
    },
    "subscription.schoolOff.continue" : {
