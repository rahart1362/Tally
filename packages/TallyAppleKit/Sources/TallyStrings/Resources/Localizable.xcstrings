    "family.invite.shareText" : {
      "comment" : "Text the student shares with a parent. 1 and 2: the school's name. 3: the pairing code. 4: a formatted date. Never contains grades; the code is never part of a link.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I'd like you to see my %1$@ Canvas in Tally.\n1. Get Tally from the App Store.\n2. Choose %2$@, then \"I'm a parent\".\n3. Sign in or create your parent account.\n4. Enter code %3$@ (case-sensitive, expires %4$@)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Quiero que veas mi Canvas de %1$@ en Tally.\n1. Descarga Tally desde la App Store.\n2. Elige %2$@ y luego \"Soy madre o padre\".\n3. Inicia sesión o crea tu cuenta de madre/padre.\n4. Ingresa el código %3$@ (distingue mayúsculas y minúsculas, vence %4$@)."
          }
        }
      }
    },
