    "grades.info.body.course" : {
      "comment" : "Info bubble body for one course whose grades the school does not appear to enter into Canvas. 'Grade portal' is the school's own grading website or app.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your school doesn't appear to enter grades for this course into Canvas, so Tally can't show them. Your assignments, due dates and reminders still work. Check your school's grade portal for this grade."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tu escuela no parece registrar las calificaciones de este curso en Canvas, así que Tally no puede mostrarlas. Tus tareas, fechas de entrega y recordatorios siguen funcionando. Revisa el portal de calificaciones de tu escuela para esta calificación."
          }
        }
      }
    },
    "grades.info.body.school" : {
      "comment" : "Info bubble body when none of the student's courses appear to have grades in Canvas. It leads to the 'Tell My School' button.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your school doesn't appear to enter your grades directly into Canvas. Tally can show only grades that are posted in Canvas. Your assignments, due dates and reminders still work. If you'd like to see your grades in Tally, you can let your school know."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tu escuela no parece registrar tus calificaciones directamente en Canvas. Tally solo puede mostrar las calificaciones publicadas en Canvas. Tus tareas, fechas de entrega y recordatorios siguen funcionando. Si quieres ver tus calificaciones en Tally, puedes avisarle a tu escuela."
          }
        }
      }
    },
    "grades.info.button" : {
      "comment" : "VoiceOver label of the info button next to a course whose grades are not in Canvas. The placeholder is the course code from Canvas, such as 'ENG-10'.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "About grades for %@"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Acerca de las calificaciones de %@"
          }
        }
      }
    },
    "grades.info.shareText" : {
      "comment" : "A message the student sends to their school from the share sheet, in the student's own voice. The placeholder is the school's name. Keep it free of links and prices.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hello, I'm a student at %@. I use Canvas to keep track of my assignments, but my grades don't appear there. Would the school consider entering grades in Canvas too? I could then see my grades next to my work, in Canvas and in apps I use with it, like Tally. Thank you."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Hola, soy estudiante de %@. Uso Canvas para llevar el control de mis tareas, pero mis calificaciones no aparecen ahí. ¿Podría la escuela considerar registrar también las calificaciones en Canvas? Así podría ver mis calificaciones junto a mi trabajo, en Canvas y en apps que uso con él, como Tally. Gracias."
          }
        }
      }
    },
    "grades.info.shareText.noSchool" : {
      "comment" : "The same message the student sends to their school, used when the school's name is not known. Keep it free of links and prices.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hello, I'm a student at your school. I use Canvas to keep track of my assignments, but my grades don't appear there. Would the school consider entering grades in Canvas too? I could then see my grades next to my work, in Canvas and in apps I use with it, like Tally. Thank you."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Hola, soy estudiante de esta escuela. Uso Canvas para llevar el control de mis tareas, pero mis calificaciones no aparecen ahí. ¿Podría la escuela considerar registrar también las calificaciones en Canvas? Así podría ver mis calificaciones junto a mi trabajo, en Canvas y en apps que uso con él, como Tally. Gracias."
          }
        }
      }
    },
