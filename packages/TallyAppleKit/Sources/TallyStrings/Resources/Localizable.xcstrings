      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Letter grades only"
          }
        }
      }
    },
    "dashboard.hero.reason.noPercentage" : {
      "comment" : "In the list of courses left out of the Dashboard's average: Canvas shows this course's grade without a percentage to average.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No percentage in Canvas"
          }
        }
      }
    },
    "dashboard.reason.courseBelowGoal" : {
      "comment" : "Next Up reason, after the due-date part: the course is below the student's goal.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "course below your goal"
          }
        }
      }
    },
    "dashboard.reason.courseWeight" : {
      "comment" : "Next Up reason: roughly how much of the course grade this item is worth. 1: a percentage such as '11%'. 2: the course code from Canvas.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "~%1$@ of %2$@"
          }
        }
      }
    },
    "dashboard.reason.dueInHours" : {
      "comment" : "Next Up reason, short: the item is due in this many hours. 'h' abbreviates hours.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Due in %lldh"
          }
        }
      }
    },
    "dashboard.reason.dueInMinutes" : {
      "comment" : "Next Up reason, short: the item is due in this many minutes (under an hour). 'm' abbreviates minutes.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Due in %lldm"
          }
        }
      }
    },
    "dashboard.reason.join" : {
