              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Average of %lld courses"
                }
              }
            }
          }
        }
      }
    },
    "dashboard.hero.noGrades" : {
      "comment" : "Dashboard hero when no course has a grade to average yet.",
