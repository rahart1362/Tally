{
  "sourceLanguage" : "en",
  "strings" : {
    "account.disclaimer" : {
      "comment" : "The required non-affiliation disclaimer (app-store-compliance.md R10). 'Instructure, Inc.' and 'Canvas' are proper nouns and stay as written.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tally is an independent app and is not affiliated with, endorsed by, or sponsored by Instructure, Inc. Canvas is a trademark of Instructure, Inc."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tally es una app independiente, no afiliada a Instructure, Inc. ni patrocinada o avalada por ella. Canvas es una marca comercial de Instructure, Inc."
          }
        }
      }
    },
    "account.done" : {
      "comment" : "Dismiss button for a sheet.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Done"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Listo"
          }
        }
      }
    },
    "account.exploreWithSampleData" : {
      "comment" : "Secondary button that opens Tally in sample-data mode, without signing in.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Explore with Sample Data"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Explorar con datos de muestra"
          }
        }
      }
    },
    "account.findMySchool" : {
      "comment" : "Primary button that starts the school search, to sign in with Canvas.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Find My School"
