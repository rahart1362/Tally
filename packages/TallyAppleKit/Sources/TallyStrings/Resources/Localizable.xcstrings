    "calendar.subscribeAlert.body" : {
      "comment" : "Calendar tab's sample-data subscription alert body.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sample data has no real calendar feed. Once you sign in, this adds your own Canvas calendar to the Calendar app, and it stays up to date there."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Los datos de muestra no tienen un calendario real. Cuando inicies sesión, esto agregará tu propio calendario de Canvas a la app Calendario, y se mantendrá actualizado allí."
          }
        }
      }
    },
