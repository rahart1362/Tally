{
  "sourceLanguage" : "en",
  "strings" : {
    "courseDetail.notInCanvas.line" : {
      "comment" : "Course Detail, in place of the recent grades and the category percentages, when the school does not appear to enter this course's grades into Canvas.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grades for this course aren't in Canvas."
          }
        }
      }
    },
    "courseDetail.override.automatic" : {
      "comment" : "Answer to 'This course's grades are kept outside Canvas': Tally decides from what Canvas shows.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automatic"
          }
        }
      }
    },
    "courseDetail.override.menu" : {
      "comment" : "Label of the Course Detail toolbar menu (an ellipsis button) that holds the course's settings.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Course Options"
          }
        }
      }
    },
    "courseDetail.override.no" : {
      "comment" : "Answer to 'This course's grades are kept outside Canvas': no, they are in Canvas.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No"
          }
        }
      }
    },
    "courseDetail.override.title" : {
      "comment" : "Course Detail menu: a setting whose answers are Automatic, Yes and No. Yes means the student's school keeps this course's grades in another system (for example a district grade portal), not in Canvas.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This course's grades are kept outside Canvas"
          }
        }
      }
    },
    "courseDetail.override.yes" : {
      "comment" : "Answer to 'This course's grades are kept outside Canvas': yes, they are.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yes"
          }
        }
      }
    },
    "courseDetail.whatIf.button" : {
      "comment" : "Button that opens the what-if calculator, where the student tries scores on work that isn't graded yet.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Try What-If Scores"
          }
        }
      }
    },
    "courseDetail.whatIf.estimate.allZero" : {
      "comment" : "In the what-if calculator, when every category weight the student set or left is 0.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "At least one category needs a weight above 0. Until then, Tally uses this course's setting in Canvas."
          }
        }
      }
    },
    "courseDetail.whatIf.estimate.disclaimer" : {
      "comment" : "At the top of the what-if calculator for a course whose grades the school keeps in another system: the student types their real scores and Tally estimates the course grade.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estimate only. Your school keeps grades outside Canvas, so Tally uses this course's Canvas categories, which may not match how your school weighs your grade."
          }
        }
      }
    },
    "courseDetail.whatIf.estimate.invalidWeight" : {
      "comment" : "Under a category weight the student typed that is not a number from 0 to 100.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enter a number from 0 to 100. Until then, this category uses its setting in Canvas."
          }
        }
      }
    },
    "courseDetail.whatIf.estimate.none" : {
      "comment" : "Accessibility label of the what-if calculator's summary when there is no grade to estimate yet.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No estimate yet. Enter a score to see one."
          }
        }
      }
    },
    "courseDetail.whatIf.estimate.overHundred" : {
      "comment" : "In the what-if calculator, when the category weights add up to more than 100 percent.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "These weights add up to more than 100%, so the estimate can come out higher than your real grade."
          }
        }
      }
    },
    "courseDetail.whatIf.estimate.total" : {
      "comment" : "The sum of the category weights in the what-if calculator. The placeholder is a percentage, for example 100%.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Total: %@"
          }
        }
      }
    },
    "courseDetail.whatIf.estimate.weightLabel" : {
      "comment" : "Accessibility label of a number field in the what-if calculator. The placeholder is the name of an assignment category from Canvas.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Weight for %@, percent of grade"
          }
        }
      }
    },
    "courseDetail.whatIf.estimate.weightsFooter" : {
      "comment" : "Under the category weights in the what-if calculator.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Each weight is a percent of the grade. Categories you leave blank use this course's setting in Canvas."
          }
        }
      }
    },
    "courseDetail.whatIf.estimate.weightsHeader" : {
      "comment" : "Section header in the what-if calculator: how much each assignment category counts toward the course grade.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Category weights"
          }
        }
      }
    },
    "courseDetail.whatIf.hiddenTotals" : {
      "comment" : "Why the what-if calculator is not offered: the instructor hides the course total in Canvas.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "What-if isn't available: your instructor has hidden course totals."
          }
        }
      }
    },
    "courseDetail.whatIf.lettersOnly" : {
      "comment" : "Why the what-if calculator is not offered: the course shows letter grades, not percentages.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "What-if isn't available for a course that shows letter grades only."
          }
        }
      }
    },
    "courseDetail.whatIf.noGradePosted" : {
      "comment" : "Why the what-if calculator is not offered: a letter-grade course with no grade posted yet.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "What-if isn't available: no grade has been posted yet."
          }
        }
      }
    },
    "courseDetail.whatIf.notInCanvas" : {
      "comment" : "Under the disabled what-if button: the what-if calculator works from Canvas grades, and this course's grades are not in Canvas.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "What-if needs grades in Canvas, and this course's grades don't appear to be kept there."
          }
        }
      }
    },
    "courseDetail.whatIf.nothingToTry" : {
      "comment" : "Why the what-if calculator is not offered: every assignment already has a score.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Everything in this course has a score, so there is nothing to try."
          }
        }
      }
    },
    "courses.health.atRisk" : {
      "comment" : "A course's status chip: several missing items, or the grade is well below the goal.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "At risk"
          }
        }
      }
    },
    "courses.health.needsAttention" : {
      "comment" : "A course's status chip: missing work, or the grade is close to a cutoff.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Needs attention"
          }
        }
      }
    },
    "courses.health.onTrack" : {
      "comment" : "A course's status chip: nothing needs the student's attention.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "On track"
          }
        }
      }
    },
    "dashboard.attention.dueSoon.title" : {
      "comment" : "Needs Attention row: an assignment is due soon. 1: its title from Canvas. 2: the time it is due, such as '2:30 PM'.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ due %2$@"
          }
        }
      }
    },
    "dashboard.attention.missingClosed.subtitle" : {
      "comment" : "Needs Attention row, second line, for closed missing work.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Talk to your instructor"
          }
        }
      }
    },
    "dashboard.attention.missingClosed.title" : {
      "comment" : "Needs Attention row: in this course (its code from Canvas), missing work can no longer be submitted.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: missing work is closed"
          }
        }
      }
    },
    "dashboard.attention.missingOpen.subtitle" : {
      "comment" : "Needs Attention row, second line: the course code from Canvas, and that the missing work is still accepted.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ · still accepted"
          }
        }
      }
    },
    "dashboard.attention.missingOpen.title" : {
      "comment" : "Needs Attention row: this assignment (its title from Canvas) is missing.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ is missing"
          }
        }
      }
    },
    "dashboard.attention.overload.subtitle" : {
      "comment" : "Needs Attention row, second line, for a busy stretch.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Several items are due close together"
          }
        }
      }
    },
    "dashboard.attention.overload.title" : {
      "comment" : "Needs Attention row: many items are due close together from this date on, such as 'Oct 2, 2026'.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Busy stretch starting %@"
          }
        }
      }
    },
    "dashboard.changes.count" : {
      "comment" : "Dashboard chip, first part: how many things changed in Canvas since the last refresh (grades, new assignments, due dates, announcements).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld change"
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld changes"
                }
              }
            }
          }
        }
      }
    },
    "dashboard.changes.since" : {
      "comment" : "Dashboard chip. 1: how many changes, such as '6 changes'. 2: the time of the refresh, such as '2:13 PM'.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ since %2$@"
          }
        }
      }
    },
    "dashboard.hero.averageOfCourses" : {
