# macOS / Xcode
.DS_Store
xcuserdata/
*.xcuserstate
DerivedData/
*.xcresult
# XcodeGen output (regenerated from apps/TallyiOS/project.yml)
apps/TallyiOS/*.xcodeproj/
apps/TallyiOS/build/
apps/TallyiOS/*/Generated/
# `make ios-*` result bundles, logs and derived data (Makefile IOS_OUT)
build/ios/
# SwiftPM (.build-*/ holds the sanitizer and perf scratch paths the Makefile uses)
.build/
.build-*/
.swiftpm/
Package.resolved.bak
# Python tooling
__pycache__/
*.pyc
.venv/
# Signing material and secrets: never commit (SEC-13)
*.p8
*.p12
*.cer
*.mobileprovision
*.ipa
*.dSYM.zip
.env
.env.*
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots/
fastlane/test_output/
